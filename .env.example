# One key or both: OpenRouter's for the models it has, Anthropic's for Claude models through
# the Claude API (model IDs that start with claude-, like claude-opus-5-5). See the README.
OPENROUTER_API_KEY=your_key_here
# ANTHROPIC_API_KEY=your_anthropic_key_here
MODEL=openai/gpt-4o-mini
# Optional: model requests per task before the agent stops (default 25)
# MAX_TOOL_ROUNDS=25
# Optional: how much Claude models think through the Claude API: low, medium, high, xhigh or max
# (default: each model's own)
# EFFORT=high
# Optional: always run in the Docker sandbox, as with --sandbox (see the README)
# SANDBOX=docker
# Optional: more `docker run` options for the sandbox, separated by spaces
# SANDBOX_DOCKER_ARGS=--memory 4g --cpus 2
# Optional: no terminal bell when the agent needs you after working a while
# BELL=off
